<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YORU</AssemblyName>
    <RootNamespace>AnimeWitcherDesktop</RootNamespace>
    <Title>YORU</Title><Product>YORU</Product><Company>YORU</Company>
    <Description>YORU desktop anime streaming application</Description>
    <NuGetAudit>false</NuGetAudit>
    <UseSharedCompilation>false</UseSharedCompilation>
    <Version>0.9.3</Version>
    <ApplicationIcon>Assets/yoru-v9.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs"/><EmbeddedResource Remove="tests/**"/><None Remove="tests/**"/></ItemGroup>
  <ItemGroup><PackageReference Include="LibVLCSharp.WPF" Version="3.10.2"/></ItemGroup>
  <ItemGroup><Content Include="certs/*.pem" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Localization/strings.json" LogicalName="AnimeWitcherDesktop.Localization.strings.json"/></ItemGroup>
  <ItemGroup><Page Remove="Assets/yoru-mark.xaml"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/yoru-v9.ico"/><Resource Include="Assets/yoru-original.png"/></ItemGroup>
</Project>
