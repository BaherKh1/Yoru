<UserControl x:Class="AnimeWitcherDesktop.Controls.AnimeCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:i18n="clr-namespace:AnimeWitcherDesktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AnimeWitcherDesktop.Controls">
 <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5">
  <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
  <Button Click="Select_Click" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
   <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
    <Border x:Name="PosterBody" Background="#161A29" CornerRadius="10" BorderBrush="#303247" BorderThickness="1">
     <Grid><TextBlock Text="▶" FontSize="28" Foreground="#494260" HorizontalAlignment="Center" VerticalAlignment="Center"/><local:RoundedImage ArtworkSource="{Binding Poster}" FallbackSources="{Binding PosterFallbacks}" Stretch="UniformToFill"/>
      <Border Background="#DB090B13" CornerRadius="6" Padding="7,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Visibility="{Binding HasRating, Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" Foreground="#F6D66F" Margin="0,0,5,0"/><TextBlock Text="{Binding Rating}" FontWeight="SemiBold"/></StackPanel></Border>
     </Grid>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,9,0,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Grid x:Name="BadgeRow" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="YearBadge" Style="{StaticResource Chip}" Padding="7,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Year}" FontSize="11" Foreground="#BDC2D6"/></Border><Border x:Name="GenreBadge" Grid.Column="1" Style="{StaticResource Chip}" Padding="7,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Genre}" FontSize="11" MaxWidth="92" TextTrimming="CharacterEllipsis" Foreground="#BDC2D6"/></Border></Grid></StackPanel>
   </Grid>
  </Button>
  <Button Style="{StaticResource IconButton}" Width="26" Height="28" Padding="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" AutomationProperties.Name="{i18n:Tr SaveList}" Click="Save_Click"><Path StrokeThickness="1.6" StrokeLineJoin="Round" Data="M3,2 L13,2 L13,17 L8,13 L3,17 Z" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="White"/><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSaved}" Value="True"><Setter Property="Stroke" Value="{StaticResource AccentLightBrush}"/><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
 </Grid>
 <UserControl.Triggers>
  <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
  <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger>
 </UserControl.Triggers>
</UserControl>
