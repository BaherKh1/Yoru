<UserControl x:Class="AnimeWitcherDesktop.Controls.ContinueCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:i18n="clr-namespace:AnimeWitcherDesktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AnimeWitcherDesktop.Controls">
 <Grid x:Name="CardSurface"><Button Padding="0" Click="Resume_Click" FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
  <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Body" CornerRadius="10" BorderBrush="#33364C" BorderThickness="1" Background="#111622"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#9E70F4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#B59AFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
  <Grid x:Name="ArtworkSurface"><local:RoundedImage ArtworkSource="{Binding Image}" FallbackSources="{Binding ImageFallbacks}" Stretch="UniformToFill"/>
   <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00080B13"/><GradientStop Color="#30080B13" Offset="0.35"/><GradientStop Color="#F8080B13" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <Border Width="42" Height="42" Background="#930B0B16" CornerRadius="22" BorderBrush="#DAD5EB" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24"><Path Data="M0,0 L0,15 L12,7.5 Z" Fill="White" Width="12" Height="15" Stretch="Uniform" Margin="3,0,0,0"/></Border>
   <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,9">
    <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#443F4B64" BorderThickness="0" Margin="0,0,0,7" Visibility="{Binding HasProgress, Converter={StaticResource BoolVisibility}}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Position}" FontSize="11" Margin="6,0,0,0" Foreground="#C9CCDA"/></Grid>
    <TextBlock Text="{Binding Episode}" FontSize="11" Margin="0,3,0,0" Foreground="#A8AEC4" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </Grid>
 </Button><Button Content="&#x22EE;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Background="#DD151222" Click="Menu_Click" AutomationProperties.Name="{i18n:Tr HistoryMenu}"><Button.ContextMenu><ContextMenu Style="{StaticResource HistoryContextMenu}" FlowDirection="{Binding Direction, Source={x:Static i18n:Locale.Current}}"><MenuItem Style="{StaticResource HistoryRemoveItem}" Header="{i18n:Tr RemoveHistory}" Click="Remove_Click"><MenuItem.Icon><Path Stroke="#DB929E" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Data="M3,5 L17,5 M7,5 L7,2 L13,2 L13,5 M5,5 L6,19 L14,19 L15,5 M9,8 L9,15 M12,8 L12,15"/></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu></Button></Grid>
</UserControl>
