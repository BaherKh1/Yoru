<Window FlowDirection="{Binding Direction, Source={x:Static i18n:Locale.Current}}" x:Class="AnimeWitcherDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:i18n="clr-namespace:AnimeWitcherDesktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:ui="clr-namespace:AnimeWitcherDesktop.Controls" xmlns:local="clr-namespace:AnimeWitcherDesktop" Title="YORU" Icon="{x:Static local:AppIcons.Image}" Width="1366" Height="768" MinWidth="1000" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource AppBackground}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="62" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="PosterTemplate"><ui:AnimeCard Selected="Card_Selected" SaveRequested="Card_SaveRequested"/></DataTemplate>
  <DataTemplate x:Key="ContinueTemplate"><ui:ContinueCard ResumeRequested="Continue_ResumeRequested" RemoveRequested="Continue_RemoveRequested"/></DataTemplate>
  <DataTemplate x:Key="MetadataTemplate"><Border Style="{StaticResource Chip}"><TextBlock Text="{Binding}" FontSize="12"/></Border></DataTemplate>
  <Geometry x:Key="SearchIcon">M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22</Geometry>
  <DataTemplate x:Key="HomeSkeletonCard"><Grid IsHitTestVisible="False"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions><Border CornerRadius="10" Background="#181A2B" BorderBrush="#26263C" BorderThickness="1"/><StackPanel Grid.Row="1" Margin="0,12,0,0"><Border Height="12" CornerRadius="4" Background="#232438" Margin="0,0,12,8"/><Border Height="9" CornerRadius="3" Background="#1A1D2F" Margin="0,0,42,0"/></StackPanel></Grid></DataTemplate>
 </Window.Resources>
 <Border x:Name="WindowFrame" BorderBrush="#242738" BorderThickness="1" Background="{StaticResource AppBackground}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"><Image x:Name="BrandLogo" Source="{x:Static local:AppIcons.Mark}" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" Width="27" Height="30" Stretch="Uniform" Margin="0,0,15,0"/><TextBlock Text="{i18n:Tr Brand}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
   <Grid Grid.Column="1" Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
    <Border x:Name="SearchShell" MaxWidth="710" Height="40" Margin="20,0,24,0" BorderBrush="#3B3C5F" BorderThickness="1" CornerRadius="12" Background="#191C2D" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Path Data="{StaticResource SearchIcon}" Stroke="#9BA0BE" StrokeThickness="1.7" Width="19" Height="19" Stretch="Uniform"/>
      <Grid Grid.Column="1"><TextBox x:Name="SearchBox" Foreground="#F5F5FA" CaretBrush="#C4A6FF" SelectionBrush="#7650BD" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0,3" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="{i18n:Tr SearchAccessible}"/><TextBlock x:Name="SearchHint" Text="{i18n:Tr SearchPlaceholder}" Foreground="#7F85A7" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
      <Button Grid.Column="2" Style="{StaticResource TextButton}" Foreground="#969BB6" Content="{i18n:Tr SearchShortcut}" Click="FocusSearch_Click" FontSize="11"/>
     </Grid>
    </Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Style="{StaticResource IconButton}" ToolTip="{i18n:Tr CinemaMode}" AutomationProperties.Name="{i18n:Tr CinemaToggle}" Click="Cinema_Click" Margin="0,0,10,0"><Path Stroke="#E4E1F3" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M15,2 C9,8 11,16 19,16 C12,23 2,18 3,11 C3,6 7,2 15,2 Z" Stretch="Uniform"/></Button>
     <Button Style="{StaticResource CaptionButton}" ToolTip="{i18n:Tr Minimize}" AutomationProperties.Name="{i18n:Tr Minimize}" Click="Minimize_Click"><Path Data="M0,6 L12,6" Stroke="White" StrokeThickness="1.4" Stretch="Uniform"/></Button>
     <Button Style="{StaticResource CaptionButton}" ToolTip="{i18n:Tr Maximize}" AutomationProperties.Name="{i18n:Tr Maximize}" Click="Maximize_Click"><Path Data="M1,1 L12,1 L12,12 L1,12 Z" Stroke="White" StrokeThickness="1.4" Stretch="Uniform"/></Button>
     <Button Style="{StaticResource CaptionButton}" ToolTip="{i18n:Tr Close}" AutomationProperties.Name="{i18n:Tr CloseApp}" Click="Close_Click"><Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="White" StrokeThickness="1.5" Stretch="Uniform"/></Button>
    </StackPanel>
   </Grid>
   <Grid x:Name="Sidebar" Grid.Row="1" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid IsHitTestVisible="False" ClipToBounds="True"><Border x:Name="NavSelection" Background="#362555" BorderBrush="#9A5CFF" BorderThickness="1,0,0,0" CornerRadius="9" Height="47" VerticalAlignment="Top" Margin="10,1,14,0" Opacity="0"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border></Grid>
    <StackPanel x:Name="NavItems">
     <RadioButton x:Name="HomeNav" Style="{StaticResource NavButton}" GroupName="SidebarNavigation" IsChecked="True" Tag="Home" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Data="M2,11 L12,2 L22,11 M5,10 L5,22 L10,22 L10,15 L15,15 L15,22 L20,22 L20,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{i18n:Tr Home}" Margin="22,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel></RadioButton>
     <RadioButton x:Name="ExploreNav" Style="{StaticResource NavButton}" GroupName="SidebarNavigation" Tag="Explore" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SearchIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="21" Height="21" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{i18n:Tr Explore}" Margin="23,0,0,0" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="TrendingNav" Style="{StaticResource NavButton}" GroupName="SidebarNavigation" Tag="Trending" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Data="M12,1 C15,8 8,7 12,13 C17,12 17,8 18,7 C25,18 17,25 10,23 C1,22 1,13 7,8 C6,15 10,13 12,1 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="21" Height="23" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{i18n:Tr Trending}" Margin="23,0,0,0" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="HistoryNav" Style="{StaticResource NavButton}" GroupName="SidebarNavigation" Tag="History" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,6 L12,12 L17,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{i18n:Tr History}" Margin="22,0,0,0" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="ListNav" Style="{StaticResource NavButton}" GroupName="SidebarNavigation" Tag="My List" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Data="M4,2 L18,2 L18,23 L11,18 L4,23 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="20" Height="22" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{i18n:Tr MyList}" Margin="24,0,0,0" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <Border Height="1" Background="{StaticResource LineBrush}" Margin="16,13,24,18"/>
     <RadioButton x:Name="GenresNav" Style="{StaticResource NavButton}" GroupName="SidebarNavigation" Tag="Genres" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Data="M2,2 L9,2 L9,9 L2,9 Z M15,2 L22,2 L22,9 L15,9 Z M2,15 L9,15 L9,22 L2,22 Z M15,15 L22,15 L22,22 L15,22 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="21" Height="21" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{i18n:Tr Genres}" Margin="23,0,0,0" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="SeasonalNav" Style="{StaticResource NavButton}" GroupName="SidebarNavigation" Tag="Seasonal" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Data="M3,5 L21,5 L21,22 L3,22 Z M3,10 L21,10 M7,1 L7,7 M17,1 L17,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="21" Height="22" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{i18n:Tr Seasonal}" Margin="23,0,0,0" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="SettingsNav" Style="{StaticResource NavButton}" GroupName="SidebarNavigation" Tag="Settings" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Viewbox x:Name="SettingsIcon" Width="24" Height="24" VerticalAlignment="Center" Stretch="Uniform"><Canvas Width="26" Height="26"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M10,2 L16,2 L17,5 L19,6 L22,6 L25,11 L23,14 L23,16 L24,19 L20,23 L17,22 L15,23 L13,25 L8,23 L8,20 L6,18 L3,18 L1,12 L3,10 L4,8 L4,5 L9,2 Z M17.5,13 A4.5,4.5 0 1 0 8.5,13 A4.5,4.5 0 1 0 17.5,13"/></Canvas></Viewbox><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{i18n:Tr Settings}" Margin="20,0,0,0" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="{i18n:Tr Version}" FontSize="10" Foreground="#616780" Margin="28,20"/>
   </Grid>
   <Grid x:Name="PageHost" Grid.Row="1" Grid.Column="1" Margin="8,0,20,0">
    <ScrollViewer x:Name="HomePage" Style="{StaticResource PageScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,2,0,12">
      <Grid x:Name="Hero" Height="350" DataContext="{Binding Featured}">
       <Grid x:Name="HeroLive" Visibility="Collapsed">
       <Border CornerRadius="12" Background="#131524" BorderBrush="#242739" BorderThickness="1"/>
       <ui:RoundedImage ArtworkSource="{Binding Cover}" FallbackSources="{Binding CoverFallbacks}" Stretch="UniformToFill" Radius="12"/>
       <Border CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F805060C"/><GradientStop Color="#DD05060C" Offset="0.27"/><GradientStop Color="#6005060C" Offset="0.58"/><GradientStop Color="#1005060C" Offset="1"/></LinearGradientBrush></Border.Background></Border>
       <Border CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0005070D" Offset="0.5"/><GradientStop Color="#BF05070D" Offset="1"/></LinearGradientBrush></Border.Background></Border>
       <Grid x:Name="HeroCopy" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,22,0,28" Width="540"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#CD21182F" CornerRadius="16" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,8"><TextBlock Text="{i18n:Tr Featured}" FontSize="11" FontWeight="SemiBold" Foreground="#B786FF"/></Border>
        <TextBlock Grid.Row="1" x:Name="HeroTitle" Text="{Binding Name}" FontSize="44" FontWeight="Bold" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" MaxHeight="112"/>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Metadata}" ItemTemplate="{StaticResource MetadataTemplate}" Margin="0,12,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <TextBlock x:Name="HeroSynopsis" ClipToBounds="True" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Grid.Row="3" Text="{Binding Story}" FontSize="14" TextWrapping="Wrap" LineHeight="20" MaxHeight="61" Foreground="#DDDDE6" Margin="0,0,0,17"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Click="HeroWatch_Click" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Path Data="M0,0 L0,14 L11,7 Z" Fill="White" Width="11" Height="14" Stretch="Uniform" Margin="0,0,11,0"/><TextBlock Text="{i18n:Tr WatchNow}" FontWeight="SemiBold"/></StackPanel></Button><Button Style="{StaticResource GhostButton}" Click="HeroSave_Click" Margin="0,0,12,0"><TextBlock Text="{Binding SaveAction}"/></Button><Button Style="{StaticResource GhostButton}" Content="{i18n:Tr MoreInfo}" Click="HeroInfo_Click"/></StackPanel>
       </Grid>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,20"><ItemsControl x:Name="HeroDots" VerticalAlignment="Center" Margin="0,0,48,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="{Binding DotWidth}" Height="8" Margin="0,0,8,0" Padding="0" BorderThickness="0" Background="{Binding Fill}" Tag="{Binding Index}" Click="HeroDot_Click" ToolTip="{i18n:Tr ChangeFeatured}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4"/></ControlTemplate></Button.Template></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Visibility="Collapsed" x:Name="HeroIndex" Foreground="#A997D0" VerticalAlignment="Center" Margin="0,0,18,0" FontSize="12"/><Button Style="{StaticResource IconButton}" Content="❮" Click="HeroPrevious_Click" Margin="0,0,10,0"/><Button Style="{StaticResource IconButton}" Content="❯" Click="HeroNext_Click"/></StackPanel>
       </Grid>
       <Grid x:Name="HeroSkeleton" IsHitTestVisible="False" AutomationProperties.Name="{i18n:Tr LoadingHome}">
        <Border CornerRadius="12" BorderBrush="#242739" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#171525"/><GradientStop Color="#201731" Offset="0.62"/><GradientStop Color="#121421" Offset="1"/></LinearGradientBrush></Border.Background></Border>
        <Grid Margin="30,24"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Border Height="20" Width="150" HorizontalAlignment="Left" CornerRadius="8" Background="#332342"/>
         <StackPanel Grid.Row="1" Margin="0,20,0,0"><Border Height="36" CornerRadius="6" Background="#30283F" Margin="0,0,12,12"/><Border Height="16" CornerRadius="5" Background="#272337" Margin="0,0,110,0"/></StackPanel>
         <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,12,0,12"><Border Height="11" CornerRadius="4" Background="#252235" Margin="0,0,0,10"/><Border Height="11" CornerRadius="4" Background="#252235" Margin="0,0,25,0"/></StackPanel>
         <StackPanel Grid.Row="3" Orientation="Horizontal"><Border Height="40" Width="120" CornerRadius="10" Background="#4A2D70" Margin="0,0,12,0"/><Border Height="40" Width="98" CornerRadius="10" Background="#262236"/></StackPanel>
        </Grid>
       </Grid>
      </Grid>
      <Grid Margin="0,14,0,0"><TextBlock Text="{i18n:Tr History}" Style="{StaticResource SectionTitle}"/><Button Content="{i18n:Tr ViewAll}" Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ViewHistory_Click"/></Grid>
      <ItemsControl x:Name="HomeHistory" ItemTemplate="{StaticResource ContinueTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ResponsiveCardPanel MinCardWidth="190" MaxColumns="5" AspectRatio="1.8" FooterHeight="0"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <Border x:Name="HistoryEmpty" Background="#111420" BorderBrush="#24283A" BorderThickness="1" CornerRadius="10" Height="112"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{i18n:Tr HistoryWaiting}" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="{i18n:Tr HistoryHint}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel></Border>
      <Grid Margin="0,14,0,0"><TextBlock Text="{i18n:Tr Popular}" Style="{StaticResource SectionTitle}"/><Button Content="{i18n:Tr ViewAll}" Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ViewPopular_Click"/></Grid>
      <Grid><ItemsControl x:Name="HomePopular" Visibility="Collapsed" ItemTemplate="{StaticResource PosterTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ResponsiveCardPanel MinCardWidth="110" MaxColumns="8" AspectRatio="0.98" FooterHeight="62"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><ItemsControl x:Name="HomePopularSkeleton" ItemTemplate="{StaticResource HomeSkeletonCard}" IsHitTestVisible="False" AutomationProperties.Name="{i18n:Tr LoadingHome}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ResponsiveCardPanel MinCardWidth="110" MaxColumns="8" AspectRatio="0.98" FooterHeight="62"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Grid>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="ExplorePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,6,0,18"><TextBlock x:Name="PageTitle" Text="{i18n:Tr ExploreAnime}" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="{i18n:Tr Discover}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel x:Name="GenreChips"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{i18n:Tr AllAnime}" Style="{StaticResource GhostButton}" Click="ClearFilters_Click" Margin="0,0,12,0"/><Button x:Name="SortButton" Content="{i18n:Tr SortRating}" Click="Sort_Click" Style="{StaticResource GhostButton}"/></StackPanel></Grid></StackPanel>
     <ListBox x:Name="Catalog" Grid.Row="1" Margin="0,-6,0,0" Padding="0" SizeChanged="Catalog_SizeChanged" ScrollViewer.ScrollChanged="Catalog_ScrollChanged" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="PART_ScrollViewer" Style="{StaticResource PageScrollViewer}" Focusable="False" Padding="0" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter Margin="0,6,0,0"/></ScrollViewer></ControlTemplate></ListBox.Template>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><ui:CatalogRowView Margin="{Binding RowMargin}" Selected="Card_Selected" SaveRequested="Card_SaveRequested"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,2"><TextBlock x:Name="PageLabel" FontSize="10" Foreground="#747C98" VerticalAlignment="Center"/><ProgressBar x:Name="CatalogLoading" Width="48" Height="2" Margin="8,0,0,0" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/><TextBlock x:Name="CatalogStatus" FontSize="10" Foreground="#747C98" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    </Grid>
    <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ListBoxItem x:Name="HistoryHeader" Padding="0" Focusable="False" HorizontalContentAlignment="Stretch"><ListBoxItem.Template><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></ListBoxItem.Template><StackPanel Margin="0,6,0,0"><Button x:Name="ClearHistoryButton" Content="{i18n:Tr ClearHistory}" Click="ClearHistory_Click" HorizontalAlignment="Right" Margin="0,0,0,12"/><TextBlock Text="{i18n:Tr History}" FontSize="30" FontWeight="Bold"/><TextBlock Text="{i18n:Tr PickUp}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24"/></StackPanel></ListBoxItem>
     <ListBox x:Name="HistoryCards" Grid.Row="1" Padding="0" SizeChanged="HistoryCards_SizeChanged" ScrollViewer.ScrollChanged="HistoryCards_ScrollChanged" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Stretch">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="PART_ScrollViewer" Style="{StaticResource PageScrollViewer}" Focusable="False" Padding="0" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><ui:ContinueRowView Margin="{Binding RowMargin}" ResumeRequested="Continue_ResumeRequested" RemoveRequested="Continue_RemoveRequested"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Grid x:Name="DetailsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Button Content="{i18n:Tr Back}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"/>
     <Grid x:Name="DetailHero" Grid.Row="1" Height="320">
      <ui:RoundedImage ArtworkSource="{Binding Cover}" FallbackSources="{Binding CoverFallbacks}" Stretch="UniformToFill"/>
      <Border CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F4080B13"/><GradientStop Color="#DD080B13" Offset="0.48"/><GradientStop Color="#50080B13" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Grid x:Name="DetailContent" Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ui:RoundedImage ArtworkSource="{Binding Poster}" FallbackSources="{Binding PosterFallbacks}" Stretch="UniformToFill" Margin="0,0,24,0"/>
       <Grid x:Name="DetailCopy" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="DetailTitle" LineStackingStrategy="BlockLineHeight" Text="{Binding Name}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="88"/>
        <ItemsControl x:Name="DetailMetadata" Grid.Row="1" ItemsSource="{Binding Metadata}" ItemTemplate="{StaticResource MetadataTemplate}" Margin="0,12,0,16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <TextBlock x:Name="DetailSynopsis" Grid.Row="2" Text="{Binding Story}" ClipToBounds="True" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="80" VerticalAlignment="Top" Foreground="#D0D1DF" FontSize="13" LineHeight="20"/>
        <StackPanel x:Name="DetailActions" Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0"><Button Content="{i18n:Tr PlayEpisode}" Style="{StaticResource PrimaryButton}" Click="DetailWatch_Click" Margin="0,0,12,0"/><Button Content="{Binding SaveLabel}" Style="{StaticResource GhostButton}" Click="DetailSave_Click"/></StackPanel>
       </Grid>
      </Grid>
