<UserControl FlowDirection="{Binding Direction, Source={x:Static i18n:Locale.Current}}" x:Class="AnimeWitcherDesktop.PlayerOverlay"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:i18n="clr-namespace:AnimeWitcherDesktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent">
 <UserControl.Resources>
  <Style x:Key="IconButton" TargetType="Button">
   <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
   <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="10"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBody" Property="Background" Value="#26FFFFFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBody" Property="BorderBrush" Value="#C6B7FF"/><Setter TargetName="ButtonBody" Property="Background" Value="#26FFFFFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBody" Property="Background" Value="#497D65CB"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBody" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TrackSegment" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
    <Border x:Name="Rail" Height="3" CornerRadius="3" VerticalAlignment="Center" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform></Border>
    <ControlTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
     <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.6666667" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
     <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
    </DataTrigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="VideoSlider" TargetType="Slider">
   <Setter Property="Height" Value="28"/><Setter Property="Background" Value="#40FFFFFF"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent" MinHeight="28" SnapsToDevicePixels="True">
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="Horizontal">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackSegment}" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackSegment}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Slider}}"/></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb x:Name="SeekThumb" Width="12" Height="12" RenderTransformOrigin="0.5,0.5"><Thumb.RenderTransform><ScaleTransform ScaleX="0.65" ScaleY="0.65"/></Thumb.RenderTransform><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White"><Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="0" Opacity="0.45"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="SeekThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.12"/>
       <DoubleAnimation Storyboard.TargetName="SeekThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.12"/>
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="SeekThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.65" Duration="0:0:0.16"/>
       <DoubleAnimation Storyboard.TargetName="SeekThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.65" Duration="0:0:0.16"/>
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SeekThumb" Property="Width" Value="16"/><Setter TargetName="SeekThumb" Property="Height" Value="16"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <!-- Nonzero alpha retains native-window pointer/touch input even when chrome is hidden. -->
 <Grid x:Name="InputSurface" Background="#01000000">
  <Grid x:Name="Chrome" Opacity="1">
   <Border VerticalAlignment="Top" Height="160" IsHitTestVisible="False">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D1090B13" Offset="0"/><GradientStop Color="#70090B13" Offset="0.55"/><GradientStop Color="#00090B13" Offset="1"/></LinearGradientBrush></Border.Background>
   </Border>
   <StackPanel Margin="32,26,32,0" VerticalAlignment="Top" IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal" Height="12"><Image Source="{x:Static i18n:AppIcons.Mark}" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="{i18n:Tr BrandPlayer}" Foreground="{DynamicResource AccentLightBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
    <TextBlock x:Name="VideoTitle" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="PlaybackStatus" Foreground="#BFD0D2E0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <Border VerticalAlignment="Bottom" Height="185" IsHitTestVisible="False">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00090B13" Offset="0"/><GradientStop Color="#99090B13" Offset="0.48"/><GradientStop Color="#EF090B13" Offset="1"/></LinearGradientBrush></Border.Background>
   </Border>
   <Grid x:Name="ControlSurface" VerticalAlignment="Bottom" Margin="28,0,28,22" Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="52"/></Grid.RowDefinitions>
    <Slider x:Name="Seek" FlowDirection="LeftToRight" Style="{StaticResource VideoSlider}" Minimum="0" Maximum="1" SmallChange="5" LargeChange="10" IsEnabled="False" AutomationProperties.Name="{i18n:Tr Position}" ToolTip="{i18n:Tr Seek}"/>
    <Grid Grid.Row="1" Margin="-6,2,-6,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="PlayPause" Style="{StaticResource IconButton}" Width="48" Height="44" ToolTip="{i18n:Tr PlayTip}" AutomationProperties.Name="{i18n:Tr Play}" Click="PlayPause_Click"><Viewbox Width="22" Height="22"><Path x:Name="PlayIcon" Fill="White" Data="M7,4 L20,12 L7,20 Z"/></Viewbox></Button>
     <Button Grid.Column="1" x:Name="Mute" Style="{StaticResource IconButton}" ToolTip="{i18n:Tr MuteTip}" AutomationProperties.Name="{i18n:Tr Mute}" Click="Mute_Click" Margin="10,0,0,0"><Viewbox Width="21" Height="21"><Path x:Name="VolumeIcon" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M16,8 C18,10 18,14 16,16 M19,5 C23,9 23,15 19,19"/></Viewbox></Button>
     <Slider Grid.Column="2" x:Name="Volume" Style="{StaticResource VideoSlider}" Width="92" Minimum="0" Maximum="100" Value="70" SmallChange="5" LargeChange="10" Margin="6,0,20,0" AutomationProperties.Name="{i18n:Tr Volume}" ToolTip="{i18n:Tr Volume}"/>
     <TextBlock Grid.Column="3" x:Name="TimeLabel" FlowDirection="LeftToRight" Text="00:00 / --:--" FontSize="12" Foreground="#E0E2EC" FontFamily="Consolas" VerticalAlignment="Center"/>
     <Border Grid.Column="5" CornerRadius="5" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="9,4" VerticalAlignment="Center" Margin="12,0,14,0"><TextBlock x:Name="QualityLabel" Text="{i18n:Tr Video}" FontSize="10" FontWeight="SemiBold" Foreground="#CFC6E9"/></Border>
     <Button Grid.Column="6" x:Name="Fullscreen" Style="{StaticResource IconButton}" ToolTip="{i18n:Tr FullscreenTip}" AutomationProperties.Name="{i18n:Tr Fullscreen}" Click="Fullscreen_Click"><Viewbox Width="20" Height="20"><Path x:Name="FullscreenIcon" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8,3 L3,3 L3,8 M16,3 L21,3 L21,8 M3,16 L3,21 L8,21 M21,16 L21,21 L16,21"/></Viewbox></Button>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
